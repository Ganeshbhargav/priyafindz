# -----------------------------------------------------------------------------
# PriyaFindz — Google Sheets Catalog & Google Drive Image Storage Configuration
# -----------------------------------------------------------------------------
# NOTE: Set these variables in your Vercel Project Settings > Environment Variables.
# NEVER commit real service account keys or private credentials to GitHub.
# -----------------------------------------------------------------------------

# 1. Google Spreadsheet ID (Private Catalog Database)
# Found in your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# Worksheet column headers:
# productId, productName, category, retailer, price, originalPrice, imageFileId, affiliateUrl, description, reelUrl, featured, isActive, createdAt
GOOGLE_SPREADSHEET_ID="your_google_spreadsheet_id_here"

# 2. Google Drive Folder ID ("PriyaFindz Product Images")
# Store product images in your Google Drive folder named "PriyaFindz Product Images".
# Found in your Drive URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id_here"

# 3. Google Cloud Service Account Authentication (Private Sheets & Drive access)
# Steps:
#   a) In Google Cloud Console > APIs & Services:
#      - Enable "Google Sheets API"
#      - Enable "Google Drive API"
#   b) In IAM & Admin > Service Accounts:
#      - Create service account (or use existing)
#      - Create and download a JSON key
#   c) In Google Sheets:
#      - Click "Share" and invite the service account email with "Viewer" access.
#   d) In Google Drive:
#      - Click "Share" on your "PriyaFindz Product Images" folder and invite the service account email with "Viewer" access.
GOOGLE_SERVICE_ACCOUNT_EMAIL="priyafindz-bot@your-gcp-project.iam.gserviceaccount.com"

# The private key from the downloaded Service Account JSON key file.
# Note: Keep the exact quotes and \n newline format:
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Alternative: You can alternatively paste the entire raw Service Account JSON as a single string:
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'

# Optional App Settings
PORT=3000
NODE_ENV="production"
